---
import Base from "../layouts/Base.astro";
import Command from "./Command.astro";
import { copy } from "../copy";
import { bundleSkills, lede, npxCommand, type Bundle } from "../data/catalog";

const { bundle } = Astro.props as { bundle: Bundle };
const skills = bundleSkills(bundle);
---

<Base
  title={`${bundle.name.en} · ${copy.appName}`}
  description={bundle.tagline.en}
  path={`/bundles/${bundle.id}/`}
>
  <article class="mx-auto w-full max-w-[720px] px-5 pt-10 pb-20 sm:px-8 sm:pt-14">
    <a href={`${copy.home}#bundles`} class="link text-[13px]">{copy.allBundles}</a>

    <div class="mt-8">
      <p class="eyebrow">{copy.bundleLabel} · {copy.skillsCount(skills.length)}</p>
    </div>
    <h1 class="type-section mt-4">{bundle.name.en}</h1>
    <p class="type-body mt-4 text-[16px]">{bundle.tagline.en}</p>

    <div class="mt-8 rounded-lg border border-line bg-bg-subtle p-5">
      <p class="eyebrow">{copy.whyLabel}</p>
      <p class="mt-3 text-[14.5px] leading-relaxed text-fg-muted">{bundle.why.en}</p>
    </div>

    <div class="mt-8 flex flex-wrap items-center gap-2.5">
      <a href={`skillset://bundle/${bundle.id}`} class="btn btn-primary">{copy.openInApp}</a>
      <a href={copy.releaseUrl} class="btn btn-quiet">{copy.download}</a>
    </div>

    <p class="eyebrow mt-12">{copy.includes}</p>
    <ul class="mt-2 list-none p-0">
      {
        skills.map((skill) => (
          <li class="row">
            <div class="min-w-0">
              <div class="flex flex-wrap items-baseline gap-x-2.5 gap-y-1">
                <a href={`/skills/${skill.id}/`} lang="en" class="type-title no-underline hover:text-accent">
                  {skill.title}
                </a>
                <span class="mono" dir="ltr" lang="en">
                  {skill.source.owner}/{skill.source.repo}
                </span>
              </div>
              <p class="type-body mt-1.5 line-clamp-2 text-[13.5px]" dir="ltr" lang="en">{lede(skill.description)}</p>
            </div>
            <a href={`skillset://skill/${skill.id}`} class="row-actions btn btn-quiet btn-sm">{copy.install}</a>
          </li>
        ))
      }
    </ul>

    <p class="eyebrow mt-10">{copy.orCli}</p>
    <div class="mt-3 grid gap-2">
      {skills.map((skill) => <Command command={npxCommand(skill)} label={copy.copy} copied={copy.copied} />)}
    </div>
  </article>
</Base>
